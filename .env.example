# Legacy V1
MDBLIST_API_KEY=
SIMKL_CLIENT_ID=
SIMKL_ACCESS_TOKEN=
DRY_RUN=true
BATCH_SIZE=50

IMDB_ENABLED=false
IMDB_DRY_RUN=true
IMDB_COOKIE=
IMDB_MAX_WRITES=25

# Rating Hub V2 core
RATING_HUB_API_KEY=
RATING_HUB_DB=./data/rating-hub.sqlite3
RATING_HUB_TARGETS=mdblist,trakt,simkl,tmdb
RATING_HUB_WORKER_IDLE=2

# Rating Hub V2 stable provider credentials
MDBLIST_ACCESS_TOKEN=
TRAKT_CLIENT_ID=
TRAKT_ACCESS_TOKEN=
TMDB_API_READ_TOKEN=
TMDB_SESSION_ID=

# IMDb V2 — experimental private-web adapter. Dry-run is ON by default.
IMDB_V2_ENABLED=false
IMDB_V2_DRY_RUN=true
IMDB_V2_WRITE_DELAY_SECONDS=2
IMDB_V2_VERIFY_WRITES=true
# Reuses IMDB_COOKIE above. Treat the cookie as password-equivalent.
# Live read-only preflight is fail-closed: choose one title already rated on
# your IMDb account and record its current 1-10 value here.
IMDB_PREFLIGHT_TITLE_ID=
IMDB_PREFLIGHT_EXPECTED_RATING=

# Letterboxd — experimental OAuth adapter. Dry-run is ON by default.
LETTERBOXD_ENABLED=false
LETTERBOXD_DRY_RUN=true
LETTERBOXD_CLIENT_ID=
LETTERBOXD_CLIENT_SECRET=
LETTERBOXD_REFRESH_TOKEN=

# Experimental providers are NOT in RATING_HUB_TARGETS by default.
# Add imdb and/or letterboxd only after provider preflight succeeds.

# Trakt inbound: movie-only scheduling; shows are manual observe-only in Phase 6A.
TRAKT_INBOUND_ENABLED=false
TRAKT_INBOUND_MEDIA_TYPES=movie
TRAKT_INBOUND_POLL_SECONDS=300

# Guarded scheduled Trakt application stays OFF unless explicitly enabled.
TRAKT_INBOUND_AUTO_APPLY=false
TRAKT_INBOUND_AUTO_APPLY_MAX_EVENTS=10
TRAKT_INBOUND_ECHO_GRACE_SECONDS=600
